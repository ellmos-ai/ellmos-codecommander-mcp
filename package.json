{
  "name": "ellmos-codecommander-mcp",
  "version": "1.3.22",
  "mcpName": "io.github.ellmos-ai/ellmos-codecommander-mcp",
  "description": "A developer-focused MCP server providing 22 tools for code analysis, JSON repair, encoding fix, import organization, Python runtime import diagnostics, structural Python editing, indentation checks, code generation, format conversion, diff, and regex testing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ellmos-codecommander": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "README_de.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "server.json",
    "smithery.yaml",
    "llms.txt"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:integration": "node test/test_new_tools.mjs",
    "test:i18n": "node test-i18n.mjs",
    "test:all": "npm run build && npm test && npm run test:integration && npm run test:i18n",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "code-analysis",
    "developer-tools",
    "json-repair",
    "encoding-fix",
    "mcp-server",
    "ai-tools",
    "claude-desktop",
    "bach",
    "python",
    "ast-analysis",
    "import-organizer",
    "mcp-registry",
    "regex-tester",
    "markdown-export",
    "pdf-export"
  ],
  "author": "Lukas Geiger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellmos-ai/ellmos-codecommander-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ellmos-ai/ellmos-codecommander-mcp/issues"
  },
  "homepage": "https://github.com/ellmos-ai/ellmos-codecommander-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@toon-format/toon": "^2.1.0",
    "fast-xml-parser": "^5.8.0",
    "js-yaml": "^4.3.1",
    "smol-toml": "^1.6.0",
    "update-notifier": "^7.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "hono": "^4.12.27",
    "@hono/node-server": "^2.0.5",
    "fast-uri": "^3.1.4",
    "ip-address": "^10.1.1",
    "fast-xml-builder": "^1.1.7",
    "qs": "^6.15.2",
    "vitest": "^3.2.6",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
