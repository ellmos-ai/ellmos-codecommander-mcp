{
  "name": "ellmos-codecommander-mcp",
  "version": "1.3.23",
  "mcpName": "io.github.ellmos-ai/ellmos-codecommander-mcp",
  "description": "A developer-focused MCP server providing 22 tools for code analysis, JSON repair, encoding fix, import organization, Python runtime import diagnostics, structural Python editing, indentation checks, code generation, format conversion, diff, and regex testing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ellmos-codecommander": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "README_de.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "server.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "code-analysis",
    "developer-tools",
    "json-repair",
    "encoding-fix",
    "mcp-server",
    "ai-tools",
    "claude-desktop",
    "bach",
    "python",
    "ast-analysis",
    "import-organizer",
    "mcp-registry",
    "regex-tester",
    "markdown-export",
    "pdf-export"
  ],
  "author": "Lukas Geiger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellmos-ai/ellmos-codecommander-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ellmos-ai/ellmos-codecommander-mcp/issues"
  },
  "homepage": "https://github.com/ellmos-ai/ellmos-codecommander-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@toon-format/toon": "^2.1.0",
    "fast-xml-parser": "^5.8.0",
    "js-yaml": "^4.3.1",
    "smol-toml": "^1.6.0",
    "update-notifier": "^7.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "hono": "^4.13.0",
    "express-rate-limit": "^8.6.2",
    "nanoid": "^3.3.17",
    "fast-uri": "^3.1.5",
    "@hono/node-server": "^2.0.5",
    "ip-address": "^10.4.0",
    "fast-xml-builder": "^1.1.7",
    "qs": "^6.15.2",
    "vitest": "^3.2.6",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
